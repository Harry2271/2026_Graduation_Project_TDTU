# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/park-smart
# Server port (default: 5000)
PORT=5000
# Directory for SLAM map PGM files (Pi default)
MAPS_DIR=/home/pi/robot_ws/maps
# JWT signing secret — generate with: openssl rand -hex 32
JWT_SIGN_SECRET=your-jwt-secret-here
# Shared secret for brain↔API Socket.io auth — generate with: openssl rand -hex 32
ROBOT_BRAIN_TOKEN=your-robot-brain-token-here
