{
  "name": "nguyen-backend",
  "script": "dist/main.js",
  "cwd": ".",
  "instances": 1,
  "exec_mode": "cluster",
  "env": {
    "NODE_ENV": "production",
    "PORT": 5000
  },
  "error_file": "/home/pi/.pm2/logs/nguyen-backend-error.log",
  "out_file": "/home/pi/.pm2/logs/nguyen-backend-out.log",
  "time": true,
  "autorestart": true,
  "max_restarts": 10,
  "max_memory_restart": "500M",
  "kill_timeout": 5000
}
