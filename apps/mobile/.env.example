# === Mobile App Environment Variables ===
# Baked into the JS bundle at build time (Expo reads these directly).
# Run: npx expo start  (uses this file automatically when .env doesn't exist)

# NestJS backend URL — used for REST + Socket.IO (packages, auth, inventory).
EXPO_PUBLIC_API_BASE_URL=https://api.nguyen-robot.io.vn

# Camera stream URL for the camera viewer (not used yet).
EXPO_PUBLIC_CAMERA_STREAM_URL=https://cam.nguyen-robot.io.vn/stream

# Robot WebSocket (port 9091, served by web_bridge.py on the Raspberry Pi).
# Used by the SLAM/LiDAR map screen to receive live scan + pose data.
# Leave blank or set to your Pi's LAN address for local development:
#   EXPO_PUBLIC_ROBOT_WS_URL=ws://192.168.1.xxx:9091
EXPO_PUBLIC_ROBOT_WS_URL=wss://map.nguyen-robot.io.vn

# Only needed when connecting directly to ws://<pi-ip>:9091 (LAN dev).
# Never commit the real value — use a local .env file.
# EXPO_PUBLIC_WS_AUTH_TOKEN=replace-with-ROBOT_BRAIN_TOKEN
