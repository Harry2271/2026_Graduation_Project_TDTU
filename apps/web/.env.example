# Public Web port used by CI/CD and docker-compose host mapping
WEB_PORT=3000

# These NEXT_PUBLIC_* values are baked into the Web bundle at Docker build time
NEXT_PUBLIC_API_BASE_URL=https://api.nguyen-robot.io.vn
NEXT_PUBLIC_API_SOCKET_URL=https://api.nguyen-robot.io.vn
NEXT_PUBLIC_WS_URL=wss://map.nguyen-robot.io.vn
# Browser credential for the raw robot WebSocket bridge. Prefer a dedicated
# WS_AUTH_TOKEN instead of exposing the privileged ROBOT_BRAIN_TOKEN.
NEXT_PUBLIC_WS_AUTH_TOKEN=
NEXT_PUBLIC_CAMERA_STREAM_URL=https://cam.nguyen-robot.io.vn/stream
