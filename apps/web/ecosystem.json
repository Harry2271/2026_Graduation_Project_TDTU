{
  "apps": [
    {
      "name": "nguyen-frontend",
      "script": "./.next/standalone/apps/web/server.js",
      "cwd": "./",
      "instances": 1,
      "exec_mode": "fork",
      "env": {
        "NODE_ENV": "production",
        "PORT": "3000",
        "HOSTNAME": "0.0.0.0",
        "NEXT_TELEMETRY_DISABLED": "1"
      },
      "error_file": "/home/pi/.pm2/logs/nguyen-frontend-error.log",
      "out_file": "/home/pi/.pm2/logs/nguyen-frontend-out.log",
      "time": true,
      "autorestart": true,
      "max_restarts": 10,
      "max_memory_restart": "1G",
      "kill_timeout": 5000
    }
  ]
}