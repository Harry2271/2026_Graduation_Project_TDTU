<?xml version="1.0"?>
<!--
  AGV robot description — minimal URDF for TF tree.

  Frame chain:
    base_footprint → base_link → laser (LiDAR mount, ~25 cm above base, 5 cm forward)
    base_link → base_imu (BNO055 mount, centered on chassis)

  Geometry is a 30 cm square mecanum chassis. Tune dimensions here when
  hardware changes; the costmap footprint in nav2_params.yaml uses the
  same values.
-->
<robot name="agv" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Ground-projected base frame published below the physical chassis. -->
  <link name="base_footprint"/>
  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Base chassis (visual + collision) -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.30 0.30 0.10"/>
      </geometry>
      <material name="chassis">
        <color rgba="0.4 0.4 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.30 0.30 0.10"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="8.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.15"/>
    </inertial>
  </link>

  <!-- RPLIDAR A1M8 (frame: laser) -->
  <joint name="base_to_laser" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="0.05 0 0.18" rpy="0 0 0"/>
  </joint>
  <link name="laser">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.04"/>
      </geometry>
      <material name="lidar">
        <color rgba="0.1 0.2 0.9 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- BNO055 IMU (frame: base_imu) -->
  <joint name="base_to_imu" type="fixed">
    <parent link="base_link"/>
    <child link="base_imu"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
  </joint>
  <link name="base_imu">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.01"/>
      </geometry>
      <material name="imu">
        <color rgba="0.9 0.6 0.1 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- 4 mecanum wheels (visual only — collision ignored; chassis box suffices) -->
  <xacro:macro name="wheel" params="name x y">
    <joint name="base_to_${name}" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} 0.04" rpy="0 0 0"/>
    </joint>
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder length="0.04" radius="0.0485"/>
        </geometry>
        <material name="wheel">
          <color rgba="0.2 0.2 0.2 1.0"/>
        </material>
      </visual>
      <inertial>
        <mass value="0.3"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:wheel name="wheel_fl" x=" 0.12"  y=" 0.13"/>
  <xacro:wheel name="wheel_fr" x=" 0.12"  y="-0.13"/>
  <xacro:wheel name="wheel_rl" x="-0.12"  y=" 0.13"/>
  <xacro:wheel name="wheel_rr" x="-0.12"  y="-0.13"/>

</robot>