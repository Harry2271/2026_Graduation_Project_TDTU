{
  "name": "nguyen-frontend",
  "script": "node_modules/next/dist/bin/next",
  "args": "start -p 3000",
  "cwd": ".",
  "instances": 1,
  "exec_mode": "fork",
  "env": {
    "NODE_ENV": "production",
    "PORT": 3000,
    "NEXT_TELEMETRY_DISABLED": "1"
  },
  "error_file": "/var/log/pm2/nguyen-frontend-error.log",
  "out_file": "/var/log/pm2/nguyen-frontend-out.log",
  "time": true,
  "autorestart": true,
  "max_restarts": 10,
  "max_memory_restart": "1G",
  "kill_timeout": 5000
}
